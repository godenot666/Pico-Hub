		lst.Position = UDim2.new(0, 10, 0, head + 4)
		lst.Size = UDim2.new(1, -20, 0, listaAlt)
		lst.BackgroundColor3 = ESCURO
		lst.BorderSizePixel = 0
		lst.ScrollBarThickness = 4
		lst.CanvasSize = UDim2.new()
		lst.AutomaticCanvasSize = Enum.AutomaticSize.Y
		lst.Parent = f
		corner(lst, 4)
		borda(lst, 2)
		lista(lst, 0)
		local lp = Instance.new("UIPadding")
		lp.PaddingTop = UDim.new(0, 4); lp.PaddingBottom = UDim.new(0, 4)
		lp.PaddingLeft = UDim.new(0, 4); lp.PaddingRight = UDim.new(0, 8)
