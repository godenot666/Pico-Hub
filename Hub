}
local AUTO_FARM_RAIO_CHEGADA = 7
local AUTO_FARM_RAIO_AREA_MACAS = 120
local AUTO_FARM_TIMEOUT_PONTO = 45
local AUTO_FARM_INTERVALO_BUSCA = 0.25

local function obterPersonagem()
    local personagem = player.Character
    local humanoide = personagem and personagem:FindFirstChildOfClass('Humanoid')
    local raiz = personagem and personagem:FindFirstChild('HumanoidRootPart')
    if not personagem or not humanoide or not raiz or humanoide.Health <= 0 then
        return nil, nil, nil
    end
    return personagem, humanoide, raiz
end

local function obterPosicao(objeto)
    if objeto:IsA('BasePart') then
        return objeto.Position
    elseif objeto:IsA('Model') then
        return objeto:GetPivot().Position
    elseif objeto:IsA('Attachment') then
        return objeto.WorldPosition
    end
    return nil
end

local function jogadorJaEstaNaAreaDasMacas()
    local _, _, raiz = obterPersonagem()
    if not raiz then return false end

    -- Se já estiver perto de qualquer ponto da área final, retoma dali.
    for _, ponto in ipairs(AUTO_FARM_ROTA) do
        if (raiz.Position - ponto).Magnitude <= AUTO_FARM_RAIO_AREA_MACAS then
            return true
        end
    end

    local pasta = workspace:FindFirstChild('AutumnApples')
    if pasta then
        for _, maca in ipairs(pasta:GetDescendants()) do
            local pos = obterPosicao(maca)
            if pos and (raiz.Position - pos).Magnitude <= AUTO_FARM_RAIO_AREA_MACAS then
                return true
            end
        end
    end
    return false
end

local function teleportarPersonagemPara(destino)
    local personagem = player.Character
    local raiz = personagem and personagem:FindFirstChild('HumanoidRootPart')
    if not personagem or not raiz then return false end

    personagem:PivotTo(CFrame.new(destino))
    raiz.AssemblyLinearVelocity = Vector3.zero
    raiz.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function moverAndandoAte(destino, geracao)
    local inicio = os.clock()
    while autoFarmAtivo and geracao == autoFarmGeracao and os.clock() - inicio < AUTO_FARM_TIMEOUT_PONTO do
        local _, humanoide, raiz = obterPersonagem()
        if not humanoide or not raiz then
            task.wait(0.25)
        elseif (raiz.Position - destino).Magnitude <= AUTO_FARM_RAIO_CHEGADA then
            return true
        else
            -- Não altera WalkSpeed: o jogo controla a velocidade normalmente.
            humanoide:MoveTo(destino)
            task.wait(0.12)
        end
    end
    return false
end

local function listarMacas()
    local pasta = workspace:FindFirstChild('AutumnApples')
    if not pasta then return {} end

    local resultado = {}
    for _, objeto in ipairs(pasta:GetChildren()) do
        local pos = obterPosicao(objeto)
        if pos then
            table.insert(resultado, {objeto = objeto, posicao = pos})
        end
    end
    table.sort(resultado, function(a, b)
        local _, _, raiz = obterPersonagem()
        if not raiz then return a.objeto.Name < b.objeto.Name end
        return (raiz.Position - a.posicao).Magnitude < (raiz.Position - b.posicao).Magnitude
    end)
    return resultado
end

local function coletarSeHouverPrompt(objeto)
    local prompt = objeto:FindFirstChildWhichIsA('ProximityPrompt', true)
    if prompt and prompt.Enabled then
        -- No jogo próprio, a coleta deve ser feita pelo servidor ao detectar
        -- o ProximityPrompt. O jogador apenas se aproxima andando.
        return true
    end
    return false
end

local function executarAutoFarm(geracao)
    -- Ao ligar novamente já dentro da área, não repete a ida ao início.
    if not jogadorJaEstaNaAreaDasMacas() then
        -- Somente a ida para a primeira posição é instantânea.
        teleportarPersonagemPara(AUTO_FARM_INICIO)
        for _, ponto in ipairs(AUTO_FARM_ROTA) do
            if not moverAndandoAte(ponto, geracao) then return end
        end
    end

    while autoFarmAtivo and geracao == autoFarmGeracao do
        local macas = listarMacas()
        if #macas == 0 then
            moverAndandoAte(AUTO_FARM_ROTA[#AUTO_FARM_ROTA], geracao)
            task.wait(AUTO_FARM_INTERVALO_BUSCA)
        else
            for _, item in ipairs(macas) do
                if not autoFarmAtivo or geracao ~= autoFarmGeracao then return end
                if item.objeto.Parent then
                    moverAndandoAte(item.posicao, geracao)
                    coletarSeHouverPrompt(item.objeto)
                    task.wait(AUTO_FARM_INTERVALO_BUSCA)
                end
            end
        end
    end
end

local function definirAutoFarm(ativo)
    autoFarmAtivo = ativo == true
    autoFarmGeracao += 1
    local geracao = autoFarmGeracao

    if autoFarmThread then
        task.cancel(autoFarmThread)
        autoFarmThread = nil
    end
    if autoFarmAtivo then
        autoFarmThread = task.spawn(function()
            executarAutoFarm(geracao)
        end)
    end
end

