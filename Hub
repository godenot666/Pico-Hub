-- Slider ligado a uma funcao. trava(true/false) = bloqueia a rolagem enquanto arrasta.
-- Retorna (trilho, destruir)
local function criarSlider(pai, f, rotValor, tam, pos, anc, trava)
	local item = f.item
	local mn, mxv, passo = item.min or 0, item.max or 100, item.passo or 1
	local sufixo = item.sufixo and ('<font color="#' .. T.acentoHex .. '">' .. item.sufixo .. '</font>') or ""

	local trilho = Instance.new("Frame")
	trilho.AnchorPoint = anc
	trilho.Position = pos
	trilho.Size = tam
	trilho.BackgroundColor3 = Color3.new(1, 1, 1)
	trilho.Parent = pai
	corner(trilho, 4)
	borda(trilho, 3)
	grad(trilho, Color3.fromRGB(40, 34, 54), ESCURO)

	local preench = Instance.new("Frame")
	preench.BackgroundColor3 = Color3.new(1, 1, 1)
	preench.BorderSizePixel = 0
	preench.Size = UDim2.fromScale(0, 1)
	preench.Parent = trilho
	corner(preench, 4)
	grad(preench, T.acentoTopo, T.acentoBase)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 16, 1, 8)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.ZIndex = 3
	knob.Parent = trilho
	corner(knob, 3)
	borda(knob, 2)
	grad(knob, Color3.new(1, 1, 1), Color3.fromRGB(196, 196, 206))

	local function pintar(v)
		local frac = (mxv > mn) and (v - mn) / (mxv - mn) or 0
		preench.Size = UDim2.fromScale(frac, 1)
		knob.AnchorPoint = Vector2.new(frac, 0.5)
		knob.Position = UDim2.new(frac, 0, 0.5, 0)
		if rotValor then rotValor.Text = tostring(v) .. sufixo end
	end
	local parar = f.ouvir(pintar)

	local function doX(x)
		local frac = math.clamp((x - trilho.AbsolutePosition.X) / math.max(1, trilho.AbsoluteSize.X), 0, 1)
		local v = math.floor((mn + frac * (mxv - mn)) / passo + 0.5) * passo
		f.definir(math.clamp(v, mn, mxv), true)
	end

	local hit = Instance.new("TextButton")
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.AnchorPoint = Vector2.new(0, 0.5)
	hit.Position = UDim2.fromScale(0, 0.5)
	hit.Size = UDim2.new(1, 0, 0, 40)
	hit.ZIndex = 5
	hit.Parent = trilho

	local deslizando, entrada = false, nil
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			deslizando = true
			entrada = input
			if trava then trava(true) end
			doX(input.Position.X)
		end
	end)
	local c1 = UIS.InputChanged:Connect(function(input)
		if deslizando and (input.UserInputType == Enum.UserInputType.MouseMovement or input == entrada) then
			doX(input.Position.X)
		end
	end)
	local c2 = UIS.InputEnded:Connect(function(input)
		if deslizando and (input == entrada or input.UserInputType == Enum.UserInputType.MouseButton1) then
			deslizando = false
			if trava then trava(false) end
		end
	end)
	return trilho, function()
		parar()
		c1:Disconnect()
		c2:Disconnect()
	end
end

