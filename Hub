------------------------------------------------------------
-- ARRASTAR (cabecalho) e RESIZE (alca) - PC e celular
-- Guarda onde o toque/clique comecou e, a cada frame, compara com a posicao
-- ATUAL do ponteiro (dedo ou cursor) e soma a diferenca ao estado inicial.
------------------------------------------------------------
local modo = nil                      -- "arrastar", "resize" ou nil
local ptrInput, ptrInicio             -- toque/clique em uso e onde comecou
local ix, iy, iw, ih = 0, 0, 0, 0     -- estado da janela quando comecou

local function comecar(input, qual)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	modo = qual
	ptrInput = input
	ptrInicio = ponteiro(input)
	ix, iy, iw, ih = jx, jy, jw, jh
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End and input == ptrInput then
			modo = nil
		end
	end)
end

header.InputBegan:Connect(function(input) comecar(input, "arrastar") end)
grip.InputBegan:Connect(function(input) comecar(input, "resize") end)

RunService.RenderStepped:Connect(function()
	if not modo then return end
	local d = ponteiro(ptrInput) - ptrInicio
	local tela = telaTam()

	if modo == "arrastar" then
		jx, jy = ix + d.X, iy + d.Y
	else
		-- o canto de cima/esquerda fica parado; limita pelo min/max e pela borda da tela
		local maxW = math.max(TAM_MIN.X, math.min(TAM_MAX.X, tela.X - ix))
		local maxH = math.max(TAM_MIN.Y, math.min(TAM_MAX.Y, tela.Y - iy))
		jx, jy = ix, iy
		jw = math.clamp(iw + d.X, TAM_MIN.X, maxW)
		jh = math.clamp(ih + d.Y, TAM_MIN.Y, maxH)
	end
	limitarJanela()
	aplicarJanela()
end)

-- garantia: soltou o mouse/dedo em qualquer lugar, para
UIS.InputEnded:Connect(function(input)
	if input == ptrInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
		modo = nil
	end
end)

