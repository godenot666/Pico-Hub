-- Seta (chevron) com duas barras. Retorna (seta, girar).
-- girar(graus, animar): 0 = "v", 180 = "^", -90 = ">"
-- Cada barra e posicionada/girada na mao (nao depende do Rotation do pai).
local function criarSeta(cor, escala)
	local c = Instance.new("Frame")
	c.BackgroundTransparency = 1
	c.AnchorPoint = Vector2.new(0.5, 0.5)
	c.Size = UDim2.fromOffset(20, 12)

	local barras = {}
	for _, d in ipairs({{-4, 45}, {4, -45}}) do -- {deslocamento x, rotacao base}
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Size = UDim2.fromOffset(12, 4)
		b.BackgroundColor3 = cor
		b.BorderSizePixel = 0
		b.Parent = c
		corner(b, 2)
		table.insert(barras, {b, d[1], d[2]})
	end
	local u = Instance.new("UIScale")
	u.Scale = escala or 1
	u.Parent = c

	local mostrado = 0
	local function pose(graus)
		mostrado = graus
		local rad = math.rad(graus)
		local cs, sn = math.cos(rad), math.sin(rad)
		for _, it in ipairs(barras) do
			local ox, oy = it[2], -1
			it[1].Position = UDim2.new(0.5, ox * cs - oy * sn, 0.5, ox * sn + oy * cs)
			it[1].Rotation = it[3] + graus
		end
	end
	pose(0)

	local nvAtual, twAtual
	local function girar(para, animar)
		if twAtual then twAtual:Cancel() end
		if nvAtual then nvAtual:Destroy() nvAtual = nil end
		if not animar then
			pose(para)
			return
		end
		local nv = Instance.new("NumberValue")
		nv.Value = mostrado
		nv.Changed:Connect(pose)
		nvAtual = nv
		twAtual = TweenService:Create(nv, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Value = para})
		twAtual:Play()
	end
	return c, girar
end

-- Botao vermelho (ou roxo) com relevo 3D. Retorna (container, botao, trocarEstilo)
-- O degrade fica num fundo separado: UIGradient num TextButton pinta o texto.
local function botao(txt, estilo)
	local e = T[estilo]
	local cont = Instance.new("Frame")
	cont.BackgroundTransparency = 1

	local base = Instance.new("Frame")
	base.BackgroundColor3 = e[3]
	base.Size = UDim2.new(1, 0, 1, -4)
	base.Position = UDim2.new(0, 0, 0, 4)
	base.ZIndex = 1
	base.Parent = cont
	corner(base, RAIO)
	borda(base, 3)

	local fundo = Instance.new("Frame")
	fundo.BackgroundColor3 = Color3.new(1, 1, 1)
	fundo.Size = UDim2.new(1, 0, 1, -4)
	fundo.ZIndex = 2
	fundo.Parent = cont
	corner(fundo, RAIO)
	borda(fundo, 3)
	local g = grad(fundo, e[1], e[2])
	brilho(fundo, 0.78, 0.38)

	local b = Instance.new("TextButton")
	b.Text = txt
	b.Font = FONT
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundTransparency = 1
	b.AutoButtonColor = false
	b.Size = UDim2.new(1, 0, 1, -4)
	b.ZIndex = 3
	b.Parent = cont
	contorno(b, 2)

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.2, 0); pad.PaddingBottom = UDim.new(0.2, 0)
	pad.PaddingLeft = UDim.new(0.08, 0); pad.PaddingRight = UDim.new(0.08, 0)
	pad.Parent = b

	local esc = Instance.new("UIScale")
	esc.Parent = cont
	local function t(v)
		TweenService:Create(esc, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {Scale = v}):Play()
	end
	b.MouseEnter:Connect(function() t(1.04) end)
	b.MouseLeave:Connect(function() t(1) end)
	b.MouseButton1Down:Connect(function() t(0.94) end)
	b.MouseButton1Up:Connect(function() t(1.04) end)

	local function trocarEstilo(novo)
		local n = T[novo]
		g.Color = ColorSequence.new(n[1], n[2])
		base.BackgroundColor3 = n[3]
	end
	return cont, b, trocarEstilo
end

