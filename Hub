local function criarSecao(pagina, sec, ordem)
	local cont = Instance.new("Frame")
	cont.BackgroundTransparency = 1
	cont.AutomaticSize = Enum.AutomaticSize.Y
	cont.Size = UDim2.new(1, 0, 0, 0)
	cont.LayoutOrder = ordem
	cont.Parent = pagina
	lista(cont, 2)

	local cab = Instance.new("TextButton")
	cab.Text = ""
	cab.AutoButtonColor = false
	cab.BackgroundTransparency = 1
	cab.Size = UDim2.new(1, 0, 0, 36)
	cab.LayoutOrder = 0
	cab.Parent = cont

	local cl = lista(cab, 8)
	cl.FillDirection = Enum.FillDirection.Horizontal
	cl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	cl.VerticalAlignment = Enum.VerticalAlignment.Center

	local seta, girar = criarSeta(Color3.new(1, 1, 1), 1)
	seta.LayoutOrder = 1
	seta.Parent = cab

	local tit = etiqueta(sec.titulo, 26, nil, Enum.TextXAlignment.Center)
	tit.TextTruncate = Enum.TextTruncate.None
	tit.AutomaticSize = Enum.AutomaticSize.X
	tit.Size = UDim2.new(0, 0, 1, 0)
	tit.LayoutOrder = 2
	tit.Parent = cab

	-- "recorte" esconde o corpo (altura 0 = fechado); o corpo guarda as linhas
	local recorte = Instance.new("Frame")
	recorte.BackgroundTransparency = 1
	recorte.ClipsDescendants = true
	recorte.Size = UDim2.new(1, 0, 0, 0)
	recorte.LayoutOrder = 1
	recorte.Parent = cont

	local corpo = Instance.new("Frame")
	corpo.BackgroundTransparency = 1
	corpo.AutomaticSize = Enum.AutomaticSize.Y
	corpo.Position = UDim2.fromOffset(4, 0)
	corpo.Size = UDim2.new(1, -8, 0, 0)
	corpo.Parent = recorte
	lista(corpo, 8)
	local cp = Instance.new("UIPadding")
	cp.PaddingTop = UDim.new(0, 4)
	cp.PaddingBottom = UDim.new(0, 4)
	cp.Parent = corpo

	local obj = {cont = cont, aberto = sec.aberto ~= false, forcado = false, linhas = {}}
	local animando = false
	local token = 0

	local function mostrando() return obj.aberto or obj.forcado end
	local function altura() return corpo.AbsoluteSize.Y / popup.Scale end

	-- aberto e parado: acompanha o tamanho do corpo (linhas que crescem/encolhem)
	corpo:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if not animando and mostrando() then
			recorte.Size = UDim2.new(1, 0, 0, altura())
		end
	end)

	function obj.aplicar(animar)
		local abrir = mostrando()
		girar(abrir and 0 or -90, animar)
		token += 1
		local meu = token
		if animar then
			animando = true
			local tw = TweenService:Create(recorte, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Size = UDim2.new(1, 0, 0, abrir and altura() or 0)})
			tw.Completed:Connect(function()
				if meu ~= token then return end
				animando = false
				if mostrando() then recorte.Size = UDim2.new(1, 0, 0, altura()) end
			end)
			tw:Play()
		else
			animando = false
			recorte.Size = UDim2.new(1, 0, 0, abrir and altura() or 0)
		end
	end

	cab.Activated:Connect(function()
		obj.aberto = not obj.aberto
		obj.aplicar(true)
	end)

	for i, item in ipairs(sec.itens) do
		criarLinha(pagina, corpo, item, i, obj)
	end
	obj.aplicar(false)
	table.insert(secoes, obj)
end

