-- Estado da janela em pixels (jx, jy = canto de cima/esquerda; jw, jh = tamanho).
-- Arrastar e resize mexem so nestes numeros e depois chamam aplicarJanela():
-- nada e lido de volta de AbsolutePosition/AbsoluteSize, entao nao tem valor velho.
local function telaTam()
	local cam = workspace.CurrentCamera
	if cam and cam.ViewportSize.X > 0 then return cam.ViewportSize end
	return gui.AbsoluteSize
end

-- posicao atual do ponteiro: toque = posicao do dedo, mouse = posicao do cursor
local function ponteiro(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UIS:GetMouseLocation()
end

local jw, jh, jx, jy = 0, 0, 0, 0

local function limitarJanela()
	local tela = telaTam()
	jw = math.clamp(jw, TAM_MIN.X, math.max(TAM_MIN.X, math.min(TAM_MAX.X, tela.X)))
	jh = math.clamp(jh, TAM_MIN.Y, math.max(TAM_MIN.Y, math.min(TAM_MAX.Y, tela.Y)))
	jx = math.clamp(jx, 0, math.max(0, tela.X - jw))
	jy = math.clamp(jy, 0, math.max(0, tela.Y - jh))
end

local function aplicarJanela()
	janela.Size = UDim2.fromOffset(jw, jh)
	janela.Position = UDim2.fromOffset(jx, jy)
end

do -- tamanho e posicao iniciais: centralizada
	local tela = telaTam()
	jw, jh = tela.X * 0.64, tela.Y * 0.82
	limitarJanela()
	jx, jy = (tela.X - jw) / 2, (tela.Y - jh) / 2
	limitarJanela()
	aplicarJanela()
end

-- girou a tela / mudou o tamanho da janela do jogo: mantem tudo visivel
do
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			limitarJanela()
			aplicarJanela()
		end)
	end
end

