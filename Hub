local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = obj
end

local function borda(obj, esp)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = esp
	s.Color = Color3.new(0, 0, 0)
	s.Parent = obj
end

local function contorno(obj, esp)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Thickness = esp or 2
	s.Color = Color3.new(0, 0, 0)
	s.Parent = obj
end

local function grad(obj, c1, c2)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = 90
	g.Parent = obj
	return g
end

local function lista(pai, padding)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 0)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = pai
	return l
end

local function etiqueta(txt, tam, cor, alinh, fonte)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = fonte or FONT_TEXTO
	l.Text = txt
	l.TextSize = tam
	l.TextColor3 = cor or Color3.new(1, 1, 1)
	l.TextXAlignment = alinh or Enum.TextXAlignment.Left
	l.TextTruncate = Enum.TextTruncate.AtEnd
	contorno(l, tam >= 20 and 2 or 1.5)
	return l
end

-- Texto que ENCOLHE para caber no espaco (nomes longos ficam menores, como na referencia)
local function etiquetaAuto(txt, maxTam, cor, alinh, minTam)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = FONT_TEXTO
	l.Text = txt
	l.TextScaled = true
	l.TextWrapped = false
	l.TextColor3 = cor or Color3.new(1, 1, 1)
	l.TextXAlignment = alinh or Enum.TextXAlignment.Left
	local lim = Instance.new("UITextSizeConstraint")
	lim.MaxTextSize = maxTam
	lim.MinTextSize = minTam or 9
	lim.Parent = l
	contorno(l, maxTam >= 20 and 2 or 1.5)
	return l
end

