-- VARIAVEIS OBSERVAVEIS + WIDGETS (toggle e slider usados em varios lugares)
-- Uma "funcao" guarda o valor e avisa todo mundo que mostra ela (janela e Quick
-- Bars). Assim, mexer em um lugar atualiza o outro, e a acao roda uma vez so.
------------------------------------------------------------
local function novaVar(valor)
	local v = {valor = valor, ouvintes = {}}
	function v.definir(novo, chamar)
		if v.valor == novo then return end
		v.valor = novo
		for _, fn in ipairs(table.clone(v.ouvintes)) do fn(novo) end
		if chamar and v.aoMudar then v.aoMudar(novo) end
	end
	function v.ouvir(fn) -- chama ja com o valor atual; devolve como parar de ouvir
		table.insert(v.ouvintes, fn)
		fn(v.valor)
		return function()
			local k = table.find(v.ouvintes, fn)
			if k then table.remove(v.ouvintes, k) end
		end
	end
	return v
end

local funcoes = {}          -- todo toggle/slider criado (a aba Quick Bar lista estes)
local abaAtualNome = ""

local function novaFuncao(item)
	local f
	if item.tipo == "toggle" then
		f = novaVar(item.padrao == true)
	else
		f = novaVar(item.valor or item.min or 0)
	end
	f.item = item
	f.nome = item.nome
	f.aba = abaAtualNome
	f.rapido = item.rapido ~= false -- rapido = false: nao aparece na lista da Quick Bar
	f.aoMudar = item.acao
	table.insert(funcoes, f)
	return f
end

-- Toggle ligado a uma variavel. aoClicar(novoValor). Retorna (botao, pararDeOuvir)
-- Desligado: caixa escura. Ligado: degrade colorido que aparece com fade + botao branco.
local function criarToggle(pai, var, aoClicar, W, H)
	local kw = math.floor(W * 0.38)
	local tr = Instance.new("TextButton")
	tr.Text = ""
	tr.AutoButtonColor = false
	tr.Size = UDim2.fromOffset(W, H)
	tr.BackgroundColor3 = Color3.new(1, 1, 1)
	tr.Parent = pai
	corner(tr, 4)
	borda(tr, 3)
	grad(tr, Color3.fromRGB(40, 34, 54), ESCURO)

	local ligadoFundo = Instance.new("Frame")
	ligadoFundo.Size = UDim2.fromScale(1, 1)
	ligadoFundo.BackgroundColor3 = Color3.new(1, 1, 1)
	ligadoFundo.BackgroundTransparency = 1
	ligadoFundo.BorderSizePixel = 0
	ligadoFundo.ZIndex = 1
	ligadoFundo.Parent = tr
	corner(ligadoFundo, 4)
	grad(ligadoFundo, T.acentoTopo, T.acentoBase)

	local kn = Instance.new("Frame")
	kn.AnchorPoint = Vector2.new(0, 0.5)
	kn.Size = UDim2.fromOffset(kw, H - 8)
	kn.BackgroundColor3 = Color3.new(1, 1, 1)
	kn.ZIndex = 2
	kn.Parent = tr
	corner(kn, 3)
	borda(kn, 2)
	grad(kn, Color3.new(1, 1, 1), Color3.fromRGB(196, 196, 206))

	local function pintar(on, animar)
		local transp = on and 0 or 1
		local pos = UDim2.new(0, on and (W - kw - 4) or 4, 0.5, 0)
		if animar then
			TweenService:Create(ligadoFundo, TweenInfo.new(0.15), {BackgroundTransparency = transp}):Play()
			TweenService:Create(kn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = pos}):Play()
		else
			ligadoFundo.BackgroundTransparency = transp
			kn.Position = pos
		end
	end
	pintar(var.valor, false)
	local parar = var.ouvir(function(v) pintar(v, true) end)
	tr.Activated:Connect(function() aoClicar(not var.valor) end)
	return tr, parar
end

