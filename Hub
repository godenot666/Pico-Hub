-- arrastar um Frame pelo "handle" (mouse e celular)
local function arrastavel(handle, alvo)
	local ativo, inp, ini, x0, y0 = false, nil, Vector2.new(), 0, 0
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			ativo = true
			inp = input
			ini = ponteiro(input)
			x0, y0 = alvo.Position.X.Offset, alvo.Position.Y.Offset
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End and input == inp then
					ativo = false
				end
			end)
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not ativo then return end
		local d = ponteiro(inp) - ini
		local tela, tam = telaTam(), alvo.AbsoluteSize
		alvo.Position = UDim2.fromOffset(
			math.clamp(x0 + d.X, 0, math.max(0, tela.X - tam.X)),
			math.clamp(y0 + d.Y, 0, math.max(0, tela.Y - tam.Y))
		)
	end)
	UIS.InputEnded:Connect(function(input)
		if input == inp or input.UserInputType == Enum.UserInputType.MouseButton1 then
			ativo = false
		end
	end)
end

-- linha de uma funcao dentro da barra. Retorna (linha, limpar)
local function criarLinhaBarra(corpo, fn, ordem)
	local item = fn.item
	local alt = (item.tipo == "slider") and 68 or 46

	local linha = Instance.new("Frame")
	linha.Size = UDim2.new(1, 0, 0, alt)
	linha.BackgroundColor3 = T.card
	linha.BackgroundTransparency = 0.1
	linha.LayoutOrder = ordem
	linha.Parent = corpo
	corner(linha, 4)
	borda(linha, 3)
	bisel(linha)

	local limpar = {}
	if item.tipo == "toggle" then
		-- nome grande que encolhe se for comprido + toggle largo na direita
		local nome = etiquetaAuto(fn.nome, 20, nil, Enum.TextXAlignment.Left, 10)
		nome.Position = UDim2.new(0, 12, 0, 0)
		nome.Size = UDim2.new(1, -100, 1, 0)
		nome.Parent = linha

		local tr, parar = criarToggle(linha, fn, function(v) fn.definir(v, true) end, 72, 32)
		tr.AnchorPoint = Vector2.new(1, 0.5)
		tr.Position = UDim2.new(1, -10, 0.5, 0)
		table.insert(limpar, parar)
	else
		-- slider: nome pequeno em cima, caixa do valor na direita, trilho embaixo
		local nome = etiquetaAuto(fn.nome, 16, nil, Enum.TextXAlignment.Left, 9)
		nome.Position = UDim2.new(0, 12, 0, 6)
		nome.Size = UDim2.new(1, -108, 0, 26)
		nome.Parent = linha

		local rot = criarCaixaValor(linha, 84, 26, UDim2.new(1, -10, 0, 6), Vector2.new(1, 0))
		local _, destruir = criarSlider(linha, fn, rot, UDim2.new(1, -24, 0, 22), UDim2.new(0, 12, 0, 40), Vector2.new(0, 0), nil)
		table.insert(limpar, destruir)
	end
	return linha, function()
		for _, f in ipairs(limpar) do f() end
	end
end

local function criarBarra(i)
	local b = {qtd = 0, itens = {}, ordem = 0, aberto = true}

	local fr = Instance.new("Frame")
	fr.Name = "QuickBar" .. i
	fr.AnchorPoint = Vector2.new(0, 0)
	fr.Position = UDim2.fromOffset(14 + (i - 1) * (QB_W + 14), 110)
	fr.Size = UDim2.fromOffset(QB_W, 0)
	fr.AutomaticSize = Enum.AutomaticSize.Y
	fr.BackgroundColor3 = Color3.new(1, 1, 1)
	fr.BackgroundTransparency = 0.08
	fr.Active = true
	fr.Visible = false
	fr.Parent = guiQB
	corner(fr, 4)
	borda(fr, 4)
	grad(fr, T.painel:Lerp(Color3.new(1, 1, 1), 0.1), T.painel)
	b.frame = fr

	local esc = Instance.new("UIScale")
	esc.Parent = fr
	b.esc = esc
	lista(fr, 0)

	-- cabecalho: arraste por aqui; a seta recolhe/expande
	local cab = Instance.new("Frame")
	cab.Size = UDim2.new(1, 0, 0, 36)
	cab.BackgroundColor3 = Color3.new(1, 1, 1)
	cab.LayoutOrder = 1
	cab.Parent = fr
	corner(cab, 4)
	borda(cab, 3)
	grad(cab, Color3.fromRGB(62, 52, 84), Color3.fromRGB(24, 20, 36))

	local titulo = etiqueta("Quick Bar " .. i, 20)
	titulo.Position = UDim2.new(0, 12, 0, 0)
	titulo.Size = UDim2.new(1, -60, 1, 0)
	titulo.Parent = cab

	local seta, girar = criarSeta(Color3.new(1, 1, 1), 1)
	seta.Position = UDim2.new(1, -22, 0.5, 0)
	seta.Parent = cab

	local corpo = Instance.new("Frame")
	corpo.BackgroundTransparency = 1
	corpo.AutomaticSize = Enum.AutomaticSize.Y
	corpo.Size = UDim2.new(1, 0, 0, 0)
	corpo.LayoutOrder = 2
	corpo.Parent = fr
	lista(corpo, 8)
	local cp = Instance.new("UIPadding")
	cp.PaddingTop = UDim.new(0, 8); cp.PaddingBottom = UDim.new(0, 8)
	cp.PaddingLeft = UDim.new(0, 8); cp.PaddingRight = UDim.new(0, 8)
	cp.Parent = corpo

	local toque = Instance.new("TextButton")
	toque.Text = ""
	toque.BackgroundTransparency = 1
	toque.AnchorPoint = Vector2.new(1, 0.5)
	toque.Position = UDim2.new(1, 0, 0.5, 0)
	toque.Size = UDim2.new(0, 46, 1, 0)
	toque.ZIndex = 3
	toque.Parent = cab
	toque.Activated:Connect(function()
		b.aberto = not b.aberto
		corpo.Visible = b.aberto
		girar(b.aberto and 0 or -90, true)
	end)

	arrastavel(cab, fr)

	function b.adicionar(fn)
		b.ordem += 1
		local linha, limpar = criarLinhaBarra(corpo, fn, b.ordem)
		b.itens[fn] = {linha = linha, limpar = limpar}
		b.qtd += 1
	end
	function b.remover(fn)
		local it = b.itens[fn]
		if not it then return end
		it.limpar()
		it.linha:Destroy()
		b.itens[fn] = nil
		b.qtd -= 1
	end
	return b
end

for i = 1, QB_N do barras[i] = criarBarra(i) end

-- poe a funcao na barra n (se ja estava em outra, move)
local function quickAdicionar(fn, n, av)
	local q = quick[fn]
	if q then barras[q.barra].remover(fn) end
	quick[fn] = {barra = n, av = av}
	barras[n].adicionar(fn)
	atualizarBarras()
end

-- tira a funcao da barra
local function quickRemover(fn)
	local q = quick[fn]
	if not q then return end
	barras[q.barra].remover(fn)
	quick[fn] = nil
	atualizarBarras()
end

