local function filtrar(q)
	q = norm(q)
	for _, sec in ipairs(secoes) do
		local achou = 0
		for _, r in ipairs(sec.linhas) do
			local ok = (q == "") or (string.find(r.nome, q, 1, true) ~= nil)
			r.f.Visible = ok
			if ok then achou += 1 end
		end
		sec.cont.Visible = (q == "") or achou > 0
		sec.forcado = (q ~= "") and achou > 0 -- na busca, secoes com resultado abrem
		sec.aplicar(false)
	end
end
